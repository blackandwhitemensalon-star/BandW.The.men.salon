NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database-name>
JWT_SECRET=<at-least-32-random-characters>
ADMIN_USER=<unique-admin-username>
ADMIN_PASS=<unique-password-of-at-least-16-characters>
CLIENT_ORIGINS=https://<your-frontend-domain>
UPLOAD_DIR=/data/bw-salon/uploads
